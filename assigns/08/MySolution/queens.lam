# Pure CPS safety, board extension, and events
# Board is newest row first. Event tags: try/place/reject/backtrack/solution/done.
# Reference: supplied eight_queens_stream.lam, for conflict arithmetic and
# lazy_make/stcn_cons syntax only. Search below is a new CPS event search.
let
  extend = lam (p: (sint, List[sint])) => list_cons(p.0, p.1);
  event = lam (p: (sint, sint, sint, List[sint])) => p;
  empty : List[sint] = list_nil();
  nil : unit -> Strm[(sint, sint, sint, List[sint])] = lam (u: unit) =>
    lazy_make(lam (v: unit) => stcn_nil());
  emit : ((sint, sint, sint, List[sint]), (unit -> Strm[(sint, sint, sint, List[sint])])) -> Strm[(sint, sint, sint, List[sint])] = lam (p) =>
    lazy_make(lam (u: unit) =>
      stcn_cons(p.0, lazy_make(lam (v: unit) => lazy_eval(p.1()))));
  safe : (sint, sint, List[sint], (unit -> Strm[(sint, sint, sint, List[sint])]), (unit -> Strm[(sint, sint, sint, List[sint])])) -> Strm[(sint, sint, sint, List[sint])] =
    fix safe(p): Strm[(sint, sint, sint, List[sint])] =>
      if list_nilq(p.2) then p.3()
      else let previous = list_head(p.2) in
        if previous == p.0 then p.4()
        else if previous == p.0 - p.1 then p.4()
        else if previous == p.0 + p.1 then p.4()
        else safe(p.0, p.1 + 1, list_tail(p.2), p.3, p.4)
      end;
  # Success receives the remaining-search continuation
  success : (List[sint], (unit -> Strm[(sint, sint, sint, List[sint])])) -> Strm[(sint, sint, sint, List[sint])] = lam (p) =>
    emit(event(4, -1, -1, p.0), p.1);
  exhausted : (unit -> Strm[(sint, sint, sint, List[sint])]) = lam (u: unit) =>
    emit(event(5, -1, -1, empty), nil);
  # Deterministic depth-first CPS search
  open : sint -> Strm[(sint, sint, sint, List[sint])] = lam (size: sint) =>
    let
      search : (sint, sint, List[sint], ((List[sint], (unit -> Strm[(sint, sint, sint, List[sint])])) -> Strm[(sint, sint, sint, List[sint])]), (unit -> Strm[(sint, sint, sint, List[sint])])) -> Strm[(sint, sint, sint, List[sint])] =
        fix search(p): Strm[(sint, sint, sint, List[sint])] =>
          let row = p.0; column = p.1; board = p.2;
              yes = p.3; no = p.4
          in
            if row == size then yes(board, no)
            else if column == size then no()
            else emit(event(0, row, column, board), lam (u: unit) =>
              safe(column, 1, board,
                lam (v: unit) =>
                  let next_board = extend(column, board) in
                    emit(event(1, row, column, next_board), lam (w: unit) =>
                      search(row + 1, 0, next_board, yes,
                        lam (x: unit) => emit(event(3, row, column, board),
                          lam (y: unit) => search(row, column + 1, board, yes, no))))
                  end,
                lam (v: unit) => emit(event(2, row, column, board),
                  lam (w: unit) => search(row, column + 1, board, yes, no))))
          end
    in
      # Opening suspends even the first call to search.
      lazy_make(lam (u: unit) => lazy_eval(search(0, 0, empty, success, exhausted)))
    end
in
  (open, safe, extend, event)
end
