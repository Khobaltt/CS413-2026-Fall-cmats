{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAMBDA3 JSON-RPC envelopes",
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "result": {},
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "requestPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/request"
          }
        }
      ]
    },
    "responsePayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/response"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/response"
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/requestPayload"
    },
    {
      "$ref": "#/$defs/responsePayload"
    }
  ]
}
